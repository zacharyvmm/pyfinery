% recorded, is the expectation.

% TEST WITH ERRORS: seed 32

class A {
    A[] r
    B[] s
    int n
}

class B {
    A[] t
    boolean f
}

atom c.
A(c).

A(a0).
B(b0).
?exists(a0).
!exists(A::new).
!exists(B::new).
default !r(*, *).
default !s(*, *).
default !t(*, *).
r(c, c).
r(c, a0).
?r(a0, c).
?r(a0, a0).
s(c, b0).
n(c): 4..5.
n(a0): 3..6.

pred p0(A x0, x1, A x2, B x3) <->
    n(x3) == 0, A(x1).

shadow pred p1(x0, A x1) <->
    !may s(y, y), y == z, !r(z, _), A(x0) ;
    !r(x1, x1), B(z), A(x0).

pred p2(A x0, A x1) <->
    !B(x1), !B(x1), !r(x0, x1), !B(z).

pred p3(A x0, B x1) <->
    n(x1) == n(x1), p2(x1, _).


