shadow pred p0(A x0, B x1) <->
    r(x0, c), !must t(y, z), must r(x0, _), must B(y).

shadow pred p1(B x0, A x1, A x2) <->
    p0+(_, z), x2 != y, may p0+(y, x0), !must A(z).

shadow pred p2(x0) <->
    p0+(y, z), A(x0), r+(_, y).

pred p3(A x0, A x1) <->
    !f(x1), exists(x0), r+(_, _), !A(x1) ;
    !A(x0), r(x1, x1), B(x0), r+(x1, z).

