% Generated by tests/conformance/generate.py from seed 15: what Refinery answers,
% recorded, is the expectation.

% TEST: seed 15

class A {
    A[] r
    B[] s
    int n
}

class B {
    A[] t
    boolean f
}

atom c.
A(c).

A(a0).
A(a1).
B(b0).
?exists(a1).
!exists(A::new).
!exists(B::new).
default !r(*, *).
default !s(*, *).
default !t(*, *).
r(c, c).
r(c, a1).
?r(a0, a0).
r(a0, a1).
?r(a1, a0).
?r(a1, a1).
?s(c, b0).
s(a1, b0).
?t(b0, c).
?t(b0, a0).
?t(b0, a1).
n(c): 3..4.
n(a0): 3..5.
n(a1): 4.

pred p0(x0, x1, A x2, x3) <->
    s(z, x0), r+(_, x0), exists(x1), A(x3).

shadow pred p1(B x0, x1) <->
    must B(c), y != z, exists(x1) ;
    !r(z, x0), exists(x1).

pred p2(A x0) <->
    B(z), A(z), r+(y, x0), !r+(x0, z).

pred p3(A x0, x1) <->
    B(z), !s(x0, _), A(x1).

pred p4(A x0, A x1) <->
    r+(x0, z), !p3+(y, z), B(_) ;
    t(c, x1), p3+(x0, z), r+(x0, x1).

pred p5(B x0, A x1, A x2) <->
    f(y), t(y, y), n(x2) <= n(y), r(y, x1).

