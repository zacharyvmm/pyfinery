% recorded, is the expectation.

% TEST WITH ERRORS: seed 100

class A {
    A[] r
    B[] s
    int n
}

class B {
    A[] t
    boolean f
}

atom c.
A(c).

A(a0).
A(a1).
B(b0).
B(b1).
!exists(A::new).
!exists(B::new).
default !r(*, *).
default !s(*, *).
default !t(*, *).
r(c, a1).
r(a0, a0).
?r(a1, a0).
?r(a1, a1).
s(c, b1).
s(a0, b0).
s(a0, b1).
?s(a1, b0).
t(b0, a0).
n(c): 5.
n(a0): 1..2.
n(a1): 1..4.
f(b0): true.
f(b1): true.

pred p0(x0) <->
    A(x0), !B(z), !B(z), !A(y) ;
    r(y, y), exists(z), A(z), r(y, _), exists(x0).

pred p1(A x0) <->
    z != y, r(y, z) ;
    !r+(c, x0).

pred p2(x0, A x1) <->
    p0(x0), !f(x0), !(n(x1) > n(x1)), r(_, x0) ;
    r+(x0, y), f(x1), A(x0).


