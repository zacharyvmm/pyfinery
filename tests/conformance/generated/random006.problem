% Generated by tests/conformance/generate.py from seed 6: what Refinery answers,
% recorded, is the expectation.

% TEST: seed 6

class A {
    A[] r
    B[] s
    int n
}

class B {
    A[] t
    boolean f
}

atom c.
A(c).

A(a0).
B(b0).
B(b1).
?exists(b0).
?exists(b1).
!exists(A::new).
!exists(B::new).
default !r(*, *).
default !s(*, *).
default !t(*, *).
?r(a0, c).
r(a0, a0).
s(c, b1).
t(b0, a0).
n(c): 4..7.
n(a0): 3.
f(b0): true.
f(b1): true.

pred p0(A x0, A x1) <->
    r(x1, y), exists(x0), !s(y, x0) ;
    B(x0).

pred p1(A x0) <->
    r+(z, x0), !r(z, z), !B(y), p0(c, z).

pred p2(x0) <->
    z != c, exists(x0).

pred p3(x0, B x1) <->
    n(x1) < n(x1), p0+(z, x1), p1(_), !B(z), exists(x0) ;
    exists(z), p0+(_, z), !A(z), !(n(x1) == n(x0)), A(x0).

pred p4(B x0, B x1) <->
    !f(x0).

pred p5(x0, A x1, x2) <->
    t(x1, x1), A(x0), A(x2).

