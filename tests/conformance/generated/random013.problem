pred p0(x0, A x1) <->
    !A(x1), !s(c, z), B(x0), r+(z, x1) ;
    f(x1), A(x0).

pred p1(A x0, A x1) <->
    A(x0).

pred p2(A x0, A x1) <->
    p1(z, x1), r(x1, y), r+(x1, x1).

pred p3(B x0, x1) <->
    s(c, c), n(x1) != 4, !A(z), exists(x1).

shadow pred p4(A x0, B x1, B x2) <->
    may B(_), !must p2(x0, x2), p3+(x1, x1), !must s(x2, c) ;
