    boolean f
}

atom c.
A(c).

A(a0).
A(a1).
A(a2).
B(b0).
B(b1).
?exists(b0).
?exists(b1).
!exists(A::new).
!exists(B::new).
default !r(*, *).
default !s(*, *).
default !t(*, *).
r(c, c).
r(c, a1).
r(a0, c).
?r(a0, a0).
r(a1, a0).
?r(a1, a1).
r(a1, a2).
