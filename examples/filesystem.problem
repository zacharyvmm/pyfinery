% File system example from the Refinery tutorial:
% https://refinery.tools/learn/tutorials/file-system

class Filesystem {
    contains Dir[1] root
}

abstract class FSObject {
    container Dir parent opposite contents
}

class Dir extends FSObject {
    contains FSObject[] contents opposite parent
}

class File extends FSObject.

class Link extends FSObject {
    FSObject[1] target
}

scope node = 5..8.
